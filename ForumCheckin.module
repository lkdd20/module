name: "NS + DF 双账号签到"
description: "v1.0.2：自动读取本地 Cookie，合并签到 NS 两账号和 DF 两账号，无需账号启用开关"
icon: "person.2.fill"
compat_arguments:
  MINUTE: "15"
  HOUR: "10"
compat_arguments_desc: |
  MINUTE/HOUR：每日签到时间，默认 10:15（设备本地时间）
  Cookie 捕获、鸡腿模式请在模块环境变量设置中修改。
  自动尝试四个账号；未获取 Cookie 的账号会跳过，不使用账号启用开关。
env_schema:
  CAPTURE_TARGET:
    name: Cookie 捕获账号
    description: 登录所选账号并刷新自己的个人页，获取成功后切回“关闭”
    default_value: "关闭"
    options: ["关闭", "NS账号1", "NS账号2", "DF账号1", "DF账号2"]
  FIXED_LEGS:
    name: 固定鸡腿（关闭为随机）
    default_value: "false"
    options: ["false", "true"]
mitm:
  hostnames:
    - www.nodeseek.com
    - www.deepflood.com
scriptings:
  - http_response:
      name: 论坛合并签到－NS Cookie
      match: '^https://www\.nodeseek\.com/api/account/getInfo(?:/|\?|$)'
      script_url: https://raw.githubusercontent.com/lkdd20/module/main/Scripts/ForumCheckin.js?v=1.0.2
      body_required: false
      timeout: 30
      env:
        CAPTURE_TARGET: "关闭"
  - http_response:
      name: 论坛合并签到－DF Cookie
      match: '^https://www\.deepflood\.com/api/account/getInfo(?:/|\?|$)'
      script_url: https://raw.githubusercontent.com/lkdd20/module/main/Scripts/ForumCheckin.js?v=1.0.2
      body_required: false
      timeout: 30
      env:
        CAPTURE_TARGET: "关闭"
  - schedule:
      name: 论坛合并签到－四账号
      cron: "{{{MINUTE}}} {{{HOUR}}} * * *"
      timeout: 90
      script_url: https://raw.githubusercontent.com/lkdd20/module/main/Scripts/ForumCheckin.js?v=1.0.2
      env:
        MODE: checkin
        FIXED_LEGS: "false"
